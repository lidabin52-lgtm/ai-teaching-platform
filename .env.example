# ==========================================
# 环境变量配置示例文件
# 复制此文件为 .env 并根据实际情况修改配置
# ==========================================

# ==========================================
# MySQL 数据库配置
# ==========================================

# MySQL root 用户密码（生产环境请使用强密码）
MYSQL_ROOT_PASSWORD=root123456

# 应用数据库名称
MYSQL_DATABASE=frontend_edu

# 应用数据库用户名
MYSQL_USER=edu_user

# 应用数据库密码（生产环境请使用强密码）
MYSQL_PASSWORD=edu_pass123

# ==========================================
# DeepSeek AI 服务配置
# ==========================================

# DeepSeek API Key（必填，从 https://platform.deepseek.com/ 获取）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API 基础地址（可选，默认使用官方地址）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型名称（可选，默认使用 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# ==========================================
# JWT 认证配置
# ==========================================

# JWT 签名密钥（生产环境请务必修改为随机强密钥）
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT Token 过期时间（小时）
JWT_EXPIRE_HOURS=24

# ==========================================
# 日志配置
# ==========================================

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==========================================
# 其他配置
# ==========================================

# 前端访问地址（用于 CORS 配置，开发环境使用）
FRONTEND_URL=http://localhost:5173

# 是否启用数据初始化（首次部署时设为 true）
INIT_DATA=false
